# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API Keys). La "publishable key" es pública por diseño:
# la seguridad la dan las políticas RLS de la base.
# NUNCA pongas acá la secret key (sb_secret_…) ni la contraseña de la base.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
